<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         YUKI THEME v1.0 — MIDNIGHT LAVENDER PALETTE
         ========================================================= -->
    <Color x:Key="MidnightColor">#111827</Color>
    <Color x:Key="DeepNavyColor">#171E2B</Color>
    <Color x:Key="SlateColor">#202B3A</Color>
    <Color x:Key="SoftSlateColor">#2B3748</Color>

    <Color x:Key="MoonlightBlueColor">#A9D8FF</Color>
    <Color x:Key="LavenderColor">#B9B5F5</Color>
    <Color x:Key="DreamLilacColor">#D6BDEB</Color>

    <Color x:Key="SuccessColor">#8BD6B0</Color>
    <Color x:Key="WarningColor">#F2C27B</Color>
    <Color x:Key="DangerColor">#EF8F9B</Color>

    <Color x:Key="LedScreenBgColor">#0B0F17</Color>
    <Color x:Key="LedPixelOffColor">#161D2B</Color>

    <Color x:Key="TextPrimaryColor">#F3F4F6</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>

    <!-- =========================================================
         SOLID COLOR BRUSHES
         ========================================================= -->
    <SolidColorBrush x:Key="MidnightBrush" Color="{StaticResource MidnightColor}"/>
    <SolidColorBrush x:Key="DeepNavyBrush" Color="{StaticResource DeepNavyColor}"/>
    <SolidColorBrush x:Key="SlateBrush" Color="{StaticResource SlateColor}"/>
    <SolidColorBrush x:Key="SoftSlateBrush" Color="{StaticResource SoftSlateColor}"/>

    <SolidColorBrush x:Key="MoonlightBlueBrush" Color="{StaticResource MoonlightBlueColor}"/>
    <SolidColorBrush x:Key="LavenderBrush" Color="{StaticResource LavenderColor}"/>
    <SolidColorBrush x:Key="DreamLilacBrush" Color="{StaticResource DreamLilacColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <SolidColorBrush x:Key="LedScreenBgBrush" Color="{StaticResource LedScreenBgColor}"/>
    <SolidColorBrush x:Key="LedPixelOffBrush" Color="{StaticResource LedPixelOffColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <!-- =========================================================
         TYPOGRAPHY & METRICS
         ========================================================= -->
    <FontFamily x:Key="PrimaryFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

    <CornerRadius x:Key="WidgetCornerRadius">22</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">18</CornerRadius>

    <!-- =========================================================
         GLOW & SHADOW EFFECTS
         ========================================================= -->
    <DropShadowEffect x:Key="WidgetShadowEffect"
                      Color="#000000"
                      BlurRadius="24"
                      ShadowDepth="4"
                      Opacity="0.55"/>

    <DropShadowEffect x:Key="AccentGlowEffect"
                      Color="{StaticResource MoonlightBlueColor}"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Opacity="0.45"/>

    <DropShadowEffect x:Key="AiGlowEffect"
                      Color="{StaticResource DreamLilacColor}"
                      BlurRadius="14"
                      ShadowDepth="0"
                      Opacity="0.40"/>

    <!-- =========================================================
         COMPONENT STYLES
         ========================================================= -->
    <!-- Thẻ chỉ số tài nguyên (6 ô) -->
    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SlateBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SoftSlateBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- Label tiêu đề thẻ chỉ số -->
    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Giá trị số liệu thời gian thực -->
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <!-- Nút icon nhỏ (VD: Chat History Toggle góc trên phải) -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="{StaticResource SlateBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SoftSlateBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource MoonlightBlueBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource MoonlightBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource SoftSlateBrush}"/>
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource LavenderBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource LavenderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thanh nhập liệu dạng viên thuốc (Pill Input) -->
    <Style x:Key="PillTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource MoonlightBlueBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0"/>
    </Style>

</ResourceDictionary>