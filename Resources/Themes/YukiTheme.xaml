<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         YUKI THEME — MIDNIGHT LAVENDER v1.0 (DESIGN TOKENS)
         ========================================================= -->

    <!-- 1. Background & Surface Colors -->
    <Color x:Key="Color.Midnight">#111827</Color>
    <Color x:Key="Color.DeepNavy">#171E2B</Color>
    <Color x:Key="Color.Slate">#202B3A</Color>
    <Color x:Key="Color.SoftSlate">#2B3748</Color>

    <!-- 2. Signature Colors -->
    <Color x:Key="Color.MoonlightBlue">#A9D8FF</Color>
    <Color x:Key="Color.Lavender">#B9B5F5</Color>
    <Color x:Key="Color.DreamLilac">#D6BDEB</Color>
    <Color x:Key="Color.BlushPink">#E8B8CC</Color>

    <!-- 3. Text Colors -->
    <Color x:Key="Color.PrimaryText">#EAF0FA</Color>
    <Color x:Key="Color.SecondaryText">#A8B5C9</Color>
    <Color x:Key="Color.MutedText">#77869C</Color>

    <!-- 4. Chat Specific Colors -->
    <Color x:Key="Color.UserBubble">#34334D</Color>
    <Color x:Key="Color.UserText">#F0EAFB</Color>

    <!-- 5. Status Colors -->
    <Color x:Key="Color.Success">#8BD6B0</Color>
    <Color x:Key="Color.Warning">#F2C27B</Color>
    <Color x:Key="Color.Danger">#EF8F9B</Color>

    <!-- =========================================================
         SEMANTIC BRUSHES
         ========================================================= -->

    <!-- Background & Surface Brushes -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Midnight}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.DeepNavy}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Slate}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.SoftSlate}"/>

    <!-- Signature Brushes -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.MoonlightBlue}"/>
    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Lavender}"/>
    <SolidColorBrush x:Key="Brush.AIIdentity" Color="{StaticResource Color.DreamLilac}"/>
    <SolidColorBrush x:Key="Brush.BlushAccent" Color="{StaticResource Color.BlushPink}"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.PrimaryText}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.SecondaryText}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.MutedText}"/>

    <!-- Chat Specific Brushes -->
    <SolidColorBrush x:Key="Brush.UserBubble" Color="{StaticResource Color.UserBubble}"/>
    <SolidColorBrush x:Key="Brush.UserText" Color="{StaticResource Color.UserText}"/>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>

</ResourceDictionary>