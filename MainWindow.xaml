<Window x:Class="YUK1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Y.U.K.1"
        Width="420" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border Background="#0D1117"
            BorderBrush="#30363D"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tầng 1: Header -->
                <RowDefinition Height="Auto"/> <!-- Tầng 2: Chỉ số thời gian thực -->
                <RowDefinition Height="*"/>    <!-- Tầng 3: Luồng chat & HITL -->
                <RowDefinition Height="Auto"/> <!-- Tầng 4: Thanh lệnh nhanh & Nhập liệu -->
            </Grid.RowDefinitions>

            <!-- TẦNG 1: HEADER (Kéo thả cửa sổ tại đây) -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Y.U.K.1"
                                   Foreground="#F0F6FC"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <Border Background="#161B22"
                                BorderBrush="#30363D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="7,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ModelStatusDot"
                                         Width="8" Height="8"
                                         Fill="#8B949E"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="ModelStatusText"
                                           Text="Chưa nạp RAM"
                                           Foreground="#8B949E"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Your Utility Kernel 1"
                               Foreground="#8B949E"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Click="CloseButton_Click"
                        Width="28" Height="28"
                        Background="#161B22"
                        Foreground="#8B949E"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Top"
                        ToolTip="Đóng"/>
            </Grid>

            <!-- TẦNG 2: DẢI CHỈ SỐ THỜI GIAN THỰC -->
            <Border Grid.Row="1"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="CPU" Foreground="#8B949E" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CpuText" Text="--%" Foreground="#58A6FF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="RAM" Foreground="#8B949E" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RamText" Text="--%" Foreground="#3FB950" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="NET" Foreground="#8B949E" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NetText" Text="-- KB/s" Foreground="#D2A8FF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TẦNG 3: LUỒNG CHAT & THẺ XÁC NHẬN HITL -->
            <Border Grid.Row="2"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatPanel">
                        <Border Background="#1F242C" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <TextBlock Text="Xin chào! Tôi là Y.U.K.1. Khung giao diện 4 tầng đã sẵn sàng."
                                       Foreground="#C9D1D9"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- TẦNG 4: THANH LỆNH NHANH & Ô NHẬP LIỆU -->
            <StackPanel Grid.Row="3">
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="⚡ Kiểm tra CPU" Background="#21262D" Foreground="#C9D1D9" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" FontSize="11" Cursor="Hand"/>
                    <Button Content="🧹 Dọn RAM" Background="#21262D" Foreground="#C9D1D9" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" FontSize="11" Cursor="Hand"/>
                    <Button Content="📊 Tiến trình nặng" Background="#21262D" Foreground="#C9D1D9" BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand"/>
                </WrapPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PromptInput"
                             Grid.Column="0"
                             Background="#161B22"
                             Foreground="#F0F6FC"
                             CaretBrush="#F0F6FC"
                             BorderBrush="#30363D"
                             BorderThickness="1"
                             Padding="10,8"
                             FontSize="12.5"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Gửi"
                            Background="#238636"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="14,8"
                            Margin="8,0,0,0"
                            Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>