<Window x:Class="YUK1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Y.U.K.1"
        Width="316"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <!-- Container ngoài có Margin để chừa khoảng cho DropShadow không bị cắt -->
    <Grid Margin="14">
        <Border x:Name="WidgetRoot"
                Background="{StaticResource MidnightBrush}"
                BorderBrush="{StaticResource SoftSlateBrush}"
                BorderThickness="1.2"
                CornerRadius="{StaticResource WidgetCornerRadius}"
                Effect="{StaticResource WidgetShadowEffect}"
                Padding="16"
                MouseLeftButtonDown="WidgetRoot_MouseLeftButtonDown">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Phần trên: LED Face + Nút History -->
                    <RowDefinition Height="Auto"/> <!-- Phần giữa: Lưới 6 chỉ số -->
                    <RowDefinition Height="Auto"/> <!-- Phần dưới: Thanh nhập liệu -->
                </Grid.RowDefinitions>

                <!-- =====================================================
                     1. GÓC TRÊN PHẢI: NÚT BẬT/TẮT LỊCH SỬ CHAT
                     ===================================================== -->
                <ToggleButton x:Name="ChatHistoryToggleButton"
                              Grid.Row="0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Panel.ZIndex="10"
                              ToolTip="Lịch sử hội thoại"
                              Style="{StaticResource IconToggleButtonStyle}">
                    <Path Data="M3,5 H13 M3,8 H11 M3,11 H9"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </ToggleButton>

                <!-- =====================================================
                     2. PHẦN TRÊN: KHUNG TRÒN GƯƠNG MẶT AI PIXEL-MATRIX
                     ===================================================== -->
                <Border Grid.Row="0"
                        Width="144"
                        Height="144"
                        CornerRadius="72"
                        Margin="0,4,0,14"
                        HorizontalAlignment="Center"
                        Background="{StaticResource LedScreenBgBrush}"
                        BorderBrush="{StaticResource SoftSlateBrush}"
                        BorderThickness="2"
                        Effect="{StaticResource AccentGlowEffect}">
                    <!-- Giai đoạn 3 sẽ nạp PixelFaceControl vào đây -->
                    <ContentControl x:Name="PixelFaceHost"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                        <!-- Placeholder tạm để xem trước đôi mắt viên nén dọc -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="14"
                                    Height="34"
                                    CornerRadius="7"
                                    Margin="0,0,22,0"
                                    Background="{StaticResource MoonlightBlueBrush}"/>
                            <Border Width="14"
                                    Height="34"
                                    CornerRadius="7"
                                    Background="{StaticResource MoonlightBlueBrush}"/>
                        </StackPanel>
                    </ContentControl>
                </Border>

                <!-- =====================================================
                     3. PHẦN GIỮA: LƯỚI GIÁM SÁT TÀI NGUYÊN 6 Ô (2x3)
                     ===================================================== -->
                <UniformGrid Grid.Row="1"
                             Rows="2"
                             Columns="3"
                             Margin="-4,0,-4,14">
                    <!-- Hàng 1: CPU | RAM | Memory -->
                    <Border Style="{StaticResource MetricCardStyle}" Margin="4">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="CpuValueText" Text="--%" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Margin="4">
                        <StackPanel>
                            <TextBlock Text="RAM" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="RamValueText" Text="--%" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Margin="4">
                        <StackPanel>
                            <TextBlock Text="MEMORY" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="MemoryValueText" Text="-- GB" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Hàng 2: GPU | Net Up | Net Down -->
                    <Border Style="{StaticResource MetricCardStyle}" Margin="4">
                        <StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="GpuValueText" Text="--%" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Margin="4">
                        <StackPanel>
                            <TextBlock Text="NET UP" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="NetUpValueText" Text="-- KB/s" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Margin="4">
                        <StackPanel>
                            <TextBlock Text="NET DOWN" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="NetDownValueText" Text="-- KB/s" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- =====================================================
                     4. PHẦN DƯỚI CÙNG: THANH NHẬP LIỆU BO TRÒN (PILL BAR)
                     ===================================================== -->
                <Border Grid.Row="2"
                        Height="38"
                        Background="{StaticResource DeepNavyBrush}"
                        BorderBrush="{StaticResource SoftSlateBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource PillCornerRadius}"
                        Padding="12,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ChatInputBox"
                                 Grid.Column="0"
                                 Style="{StaticResource PillTextBoxStyle}"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Width="28"
                                Height="28"
                                Cursor="Hand"
                                Background="{StaticResource SlateBrush}"
                                BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="14">
                                        <Path Data="M3,8 H13 M9,4 L13,8 L9,12"
                                              Width="12"
                                              Height="12"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource MoonlightBlueBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource SoftSlateBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>