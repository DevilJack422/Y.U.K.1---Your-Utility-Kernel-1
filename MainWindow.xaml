<Window x:Class="YUK1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="Y.U.K.1"
        Width="420" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid>
        <!-- SYSTEM TRAY -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Y.U.K.1 (Alt+Space)"
                        TrayLeftMouseUp="TrayIcon_LeftClick">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="Y1"
                                        Background="{DynamicResource Brush.UserBubble}"
                                        Foreground="{DynamicResource Brush.AIIdentity}"
                                        FontWeight="Bold"/>
            </tb:TaskbarIcon.IconSource>

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show / Hide Y.U.K.1" Click="ToggleWindow_Click"/>
                    <MenuItem x:Name="AutoStartMenuItem"
                              Header="Start with Windows"
                              IsCheckable="True"
                              Click="AutoStartMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- MAIN WINDOW CONTAINER (Midnight #111827) -->
        <Border Background="{DynamicResource Brush.Background}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Tier 1: Header -->
                    <RowDefinition Height="Auto"/> <!-- Tier 2: System Monitor -->
                    <RowDefinition Height="*"/>    <!-- Tier 3: Chat & HITL -->
                    <RowDefinition Height="Auto"/> <!-- Tier 4: Quick Actions & Input -->
                </Grid.RowDefinitions>

                <!-- TIER 1: HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Y.U.K.1"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <Border Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ModelStatusDot"
                                             Width="8" Height="8"
                                             Fill="{DynamicResource Brush.TextMuted}"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="{DynamicResource Color.DreamLilac}"
                                                              BlurRadius="6"
                                                              ShadowDepth="0"
                                                              Opacity="0.35"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="ModelStatusText"
                                               Text="Not loaded"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Your Utility Kernel 1"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseButton_Click"
                            Width="28" Height="28"
                            Background="{DynamicResource Brush.Card}"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            Cursor="Hand"
                            VerticalAlignment="Top"
                            ToolTip="Hide to Tray"/>
                </Grid>

                <!-- TIER 2: REALTIME SYSTEM MONITOR (DeepNavy #171E2B) -->
                <Border Grid.Row="1"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="CPU" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CpuText" Text="--%" Foreground="{DynamicResource Brush.Primary}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="RAM" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RamText" Text="--%" Foreground="{DynamicResource Brush.Success}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="NET" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NetText" Text="-- KB/s" Foreground="{DynamicResource Brush.Secondary}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TIER 3: CHAT STREAM & HITL CARDS (DeepNavy #171E2B) -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatPanel">
                            <Border Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,0,8">
                                <TextBlock Text="Hello! I'm Y.U.K.1. Midnight Lavender UI and system telemetry are ready."
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- TIER 4: QUICK COMMANDS & INPUT -->
                <StackPanel Grid.Row="3">
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="⚡ CPU Check"
                                Background="{DynamicResource Brush.Card}"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                Padding="8,4" Margin="0,0,6,0" FontSize="11" Cursor="Hand"/>
                        <Button Content="🧹 Trim RAM"
                                Background="{DynamicResource Brush.Card}"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                Padding="8,4" Margin="0,0,6,0" FontSize="11" Cursor="Hand"/>
                        <Button Content="📊 Top Processes"
                                Background="{DynamicResource Brush.Card}"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                Padding="8,4" Margin="0,0,6,0" FontSize="11" Cursor="Hand"/>
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PromptInput"
                                 Grid.Column="0"
                                 Background="{DynamicResource Brush.Card}"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 CaretBrush="{DynamicResource Brush.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 FontSize="12.5"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Send"
                                Background="{DynamicResource Brush.Primary}"
                                Foreground="{DynamicResource Brush.Background}"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Padding="14,8"
                                Margin="8,0,0,0"
                                Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>